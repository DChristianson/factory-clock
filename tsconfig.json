{
  // The page's TypeScript: the catalog and the explorer's model (src), the
  // web page's modules (src/web), the bundle entry (src/main.ts), and the
  // copy of Snagboat's schema (src/schema). The page touches the DOM, so the
  // DOM lib is on; nothing here may use Node (no node types), since the page
  // bundles all of it for the browser. `npm run build` checks it; esbuild
  // (scripts/site.js) writes the bundle. The tests have their own config.
  "compilerOptions": {
    "module": "node16",
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "outDir": "out",
    "rootDir": "src",
    "noEmit": true,
    "strict": true,
    "moduleResolution": "node16",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/test/**"]
}
